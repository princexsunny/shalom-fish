# Firebase web config — copy to .env.local and fill in.
# Firebase console → Project settings (gear) → General → "Your apps" → Web app → Config.
# These are NEXT_PUBLIC_* so the browser (client) Firebase SDK can read them.
# Leave them blank to run with browser localStorage instead of Firebase.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
